# App
PORT=3000
NODE_ENV=development
CORS_ORIGINS=

# Host port for the dockerized API (container itself still listens on 3000
# internally) — kept separate from the local `npm run start` dev server,
# which already holds host port 3000.
API_HOST_PORT=3001

# JWT Secret for token generation
JWT_SECRET="change-me-to-a-long-random-secret"

# Shared client credential required (Basic Auth) on /auth/register and
# /auth/login, on top of the per-user email/password those endpoints take.
AUTH_BASIC_USERNAME="api-client"
AUTH_BASIC_PASSWORD="change-me"

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pr_review_system2
POSTGRES_HOST_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pr_review_system2?schema=public"

# Encryption for OAuth tokens
ENCRYPTION_KEY="change-me-32-byte-base64-key"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_OAUTH_CALLBACK_URL="http://localhost:3000/accounts/github/callback"

# GitLab OAuth
GITLAB_CLIENT_ID="your_gitlab_client_id"
GITLAB_CLIENT_SECRET="your_gitlab_client_secret"
GITLAB_OAUTH_CALLBACK_URL="http://localhost:3000/accounts/gitlab/callback"

# Sync policy
PR_SYNC_STALE_MINUTES=1

# Redis
REDIS_HOST_PORT=6379
REDIS_URL="redis://localhost:6379"

# AI review (optional — soft-fail feature, app runs without it)
GROQ_API_KEY=
GROQ_MODEL=
