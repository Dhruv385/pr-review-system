{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "ES2022",
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@app/*": [
                "src/app/*"
            ],
            "@api/*": [
                "src/app/api/*"
            ],
            "@shared/*": [
                "src/app/shared/*"
            ],
            "@guards/*": [
                "src/app/guards/*"
            ],
            "@decorators/*": [
                "src/app/decorators/*"
            ],
            "@config/*": [
                "src/config/*"
            ],
            "@filter/*": [
                "src/filter/*"
            ],
            "@interceptors/*": [
                "src/interceptors/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ]
        },
        "incremental": true,
        "skipLibCheck": true,
        "strict": true,
        "strictNullChecks": true,
        "noImplicitAny": false,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}